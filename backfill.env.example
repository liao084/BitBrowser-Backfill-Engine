# Backfill 配置模板。复制为 .env 后填写本地真实配置；不要提交真实 .env。

# 历史补采浏览器来源：bitbrowser 或 external_cdp。
BROWSER_TYPE=bitbrowser

# bitbrowser 模式使用；external_cdp 模式不读取。
BITE_ID="replace_with_bitbrowser_id"

# external_cdp 模式使用。端口由启动浏览器时的
# --remote-debugging-port 决定，Edge、Chrome 等 Chromium 浏览器均可。
CDP_ADDRESS=127.0.0.1:9222

# 需由业务执行页 GC 监控的 URL 片段。
GC_PAGE_URL_MARKERS=["replace_with_business_url_marker"]

# 历史任务卡片与日期分块。
TASKS_CONFIG='[
    {"card":1001,"start":"2025-01-01","end":"2025-01-31","chunk_days":1}
]'

# 业务执行页 GC 必须晚于 Worker 的终态复检。
WORKER_HEARTBEAT_SILENCE_SECONDS=120
BUSINESS_HEARTBEAT_SILENCE_SECONDS=180

# 失败任务立即进入共享队列尾部，最多执行 5 次。
MAX_ATTEMPTS=5

# 单次 Playwright/CDP 会话只在此时长内领取新任务；在途任务继续收尾。
BACKFILL_CDP_SESSION_LIFETIME_HOURS=3.5

# 初始会话不计数；计划轮换和 Driver 异常恢复共用此重建额度。
BACKFILL_MAX_CDP_REBUILDS=5
